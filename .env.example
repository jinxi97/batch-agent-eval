# Copy to .env and fill in. .env is gitignored.

# Modal proxy token for the Shared Endpoint: "<token id>.<token secret>"
# Create with: uv run modal workspace proxy-tokens create --name harbor-eval
MODAL_PROXY_KEY=wk-XXXXXXXX.ws-XXXXXXXX

# Endpoint URL from `uv run modal endpoint info <endpoint-id>` (without /v1)
MODAL_ENDPOINT_URL=https://<workspace>--<endpoint>.us-west.modal.direct
